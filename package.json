{
    "name": "@vixen-tech/lynguist",
    "version": "1.0.1",
    "description": "",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "import": "./dist/vite.js"
        },
        "./virtual": {
            "types": "./dist/virtual-lynguist.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && tsc-alias && cp src/virtual-lynguist.d.ts dist/",
        "clean": "rm -rf dist",
        "prepublishOnly": "pnpm clean && pnpm build",
        "test": "vitest run"
    },
    "keywords": [
        "translations",
        "localization",
        "i18n"
    ],
    "author": "Alex Torscho <contact@alextorscho.com> (https://alextorscho.com)",
    "license": "ISC",
    "peerDependencies": {
        "vite": ">=5.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "prettier": "^3.7.4",
        "tsc-alias": "^1.8.16",
        "typescript": "^5.9.3",
        "vite": "^7.3.0",
        "vitest": "^4.0.16"
    },
    "directories": {
        "test": "tests"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vixen-tech/lynguist-js.git"
    },
    "bugs": {
        "url": "https://github.com/vixen-tech/lynguist-js/issues"
    },
    "homepage": "https://github.com/vixen-tech/lynguist-js#readme"
}
